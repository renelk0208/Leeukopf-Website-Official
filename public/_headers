/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/version.json
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/images/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/gelitup-media/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/gelitup-content/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
