VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Meta Pixel (Facebook Pixel) configuration
VITE_META_PIXEL_ID=your_meta_pixel_id_here

# Google Analytics 4 configuration
VITE_GA_MEASUREMENT_ID=your_ga4_measurement_id_here

# Instagram Graph API configuration
# Leeukopf Laboratories Instagram (@leeukopf_laboratories)
IG_ACCESS_TOKEN=your_instagram_long_lived_access_token_here
IG_USER_ID=your_instagram_user_id_here

# GEL.IT.UP Instagram (@gelitup)
IG_GELITUP_ACCESS_TOKEN=your_gelitup_instagram_long_lived_access_token_here
IG_GELITUP_USER_ID=your_gelitup_instagram_user_id_here

# Instagram API settings
IG_GRAPH_API_VERSION=v18.0
IG_CACHE_TTL_SECONDS=300

# Email service configuration (Resend)
RESEND_API_KEY=your_resend_api_key_here

# Google Sheets API configuration (for client registration leads)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email_here
GOOGLE_PRIVATE_KEY=your_private_key_here
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEET_TAB=Raw_Leads
